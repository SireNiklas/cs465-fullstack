<div class="box">
  <div>
    <div class="body">
      <h1>{{title}}</h1>
      <ul id="sites">
        {{#each trips}}
        <li>
          <a href="/travel"><img src="/images/{{image}}" alt="{{name}}"></a>
          <h2><a href="/travel">{{name}}</a></h2>
          <p><strong>{{resort}}</strong></p>
          <p><em>{{length}}</em> &mdash; from <strong>${{perPerson}}</strong> per person</p>
          <p>{{description}}</p>
          <p class="code">Trip code: {{code}}</p>
        </li>
        {{/each}}
      </ul>
    </div>
  </div>
</div>
