<div class="box">
  <div>
    <div class="body">
      <h1>{{title}}</h1>
      <ul id="sites">
        {{#each trips}}
        <li>
          <a href="/travel"><img src="/images/{{image}}" alt="{{name}}"></a>
          <h2><a href="/travel">{{name}}</a></h2>
          {{#each paragraphs}}
          <p>{{this}}</p>
          {{/each}}
        </li>
        {{/each}}
      </ul>
    </div>
  </div>
</div>
