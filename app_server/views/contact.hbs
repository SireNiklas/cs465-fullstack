<div class="box">
  <div>
    <div id="contact" class="body">
      <h1>Contact</h1>
      <form action="/contact" method="post">
        <table>
          <tbody>
            <tr>
              <td>Name:</td>
              <td><input type="text" value="" class="txtfield"></td>
            </tr>
            <tr>
              <td>Email:</td>
              <td><input type="text" value="" class="txtfield"></td>
            </tr>
            <tr>
              <td>Subject:</td>
              <td><input type="text" value="" class="txtfield"></td>
            </tr>
            <tr>
              <td class="txtarea">Message:</td>
              <td><textarea></textarea></td>
            </tr>
            <tr>
              <td></td>
              <td><input type="submit" value="Send" class="btn"></td>
            </tr>
          </tbody>
        </table>
      </form>
      <h2>GameBrowse</h2>
      <p>
        Use the form above to report a listing that is wrong, out of date, or
        no longer online. Include the server code if you have it, since that is
        how listings are looked up.
      </p>
      <p>
        Server owners who want to add or edit a listing should sign in to the
        admin panel instead. Edits there apply to listings you own.
      </p>
    </div>
  </div>
</div>
